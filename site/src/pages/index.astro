---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Bandlantern devlog">
  <p>
    Rebuilding a software-defined radio's demodulators and decoders from their specs, one
    protocol at a time, with the maths, the bugs, and the measurements.
  </p>
  {posts.length === 0 && <p>First posts coming soon.</p>}
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>{" "}
          <small>{post.data.date.toISOString().slice(0, 10)}</small>
          <br />
          {post.data.summary}
        </li>
      ))
    }
  </ul>
</Base>
